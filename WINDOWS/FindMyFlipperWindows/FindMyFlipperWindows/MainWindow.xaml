<Window
    x:Class="FindMyFlipperWindows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="FindMyFlipper">

    <Grid x:Name="WindowRoot" Background="{StaticResource BackgroundBrush}" MinWidth="700" MinHeight="520">
        <!-- Five-step onboarding, matching the Mac app flow. -->
        <Grid x:Name="OnboardingRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
                <RowDefinition Height="84" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="StepLabel" Text="Step 1 of 5" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" />

            <ScrollViewer Grid.Row="1"
                          HorizontalContentAlignment="Stretch"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          VerticalScrollMode="Auto">
            <Grid x:Name="OnboardingViewport">
            <Grid x:Name="OnboardingContentColumn" MaxWidth="720"
                  HorizontalAlignment="Center" Margin="20,8,20,16">
                <Grid x:Name="WelcomeStep">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="560" Spacing="22">
                        <TextBlock Text="Welcome to FindMyFlipper" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" />
                        <Border Width="88" Height="88" CornerRadius="44" Background="{StaticResource AccentBrush}">
                            <FontIcon Glyph="&#xE707;" FontSize="40" Foreground="White" />
                        </Border>
                        <TextBlock Text="Track your Flipper Zero using Find My network reports."
                                   TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontSize="16" />
                        <TextBlock Text="Your data stays local and secure. Private keys are protected by Windows Credential Manager."
                                   TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontSize="15" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="ImportStep" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="640" Spacing="14">
                        <TextBlock Text="Import .keys File" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" />
                        <Border Width="80" Height="80" CornerRadius="40" Background="{StaticResource AccentSoftBrush}">
                            <FontIcon Glyph="&#xE8D7;" FontSize="32" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <TextBlock Text="Choose the FindMyFlipper .keys file loaded on your own Flipper, or generate a new identity here. The private key is protected by Windows Credential Manager."
                                   TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                        <Border Style="{StaticResource CardStyle}" Padding="14">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Image Source="ms-appx:///Assets/flipper-zero.png" Width="104" Height="86" Stretch="Uniform" />
                                <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                                    <TextBlock Text="Copy keys to your Flipper" FontWeight="SemiBold" />
                                    <TextBlock Text="Connect the Flipper by USB and keep qFlipper closed. Keys are copied to /ext/apps_data/findmy using the official serial CLI."
                                               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="PrepareFlipperButton" Content="Check USB" Click="PrepareFlipper_Click" />
                                        <Button x:Name="CopyKeysButton" Content="Copy Current Keys" Click="CopyKeysToFlipper_Click" IsEnabled="False" Style="{StaticResource CriticalButtonStyle}" />
                                    </StackPanel>
                                    <TextBlock x:Name="FlipperUsbStatus" Text="No USB check run yet" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                            <Button Content="Choose .keys File" Click="ChooseKeys_Click" Style="{StaticResource PrimaryButtonStyle}" />
                            <Button x:Name="GenerateKeysButton" Content="Generate New Keys" Click="GenerateKeys_Click" />
                            <Button x:Name="SaveKeysButton" Content="Save a Copy" Click="SaveKeys_Click" Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock x:Name="ImportedFileLabel" Text="No identity selected" HorizontalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                        <InfoBar x:Name="KeysInfo" IsOpen="False" IsClosable="False" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="AppleStep" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="560" Spacing="10">
                        <Grid Width="68" Height="52">
                            <FontIcon Glyph="&#xE72E;" FontSize="42" Foreground="{StaticResource SecondaryTextBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="Connect Apple Access" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="Sign in to request encrypted Find My reports for your imported key. Credentials stay inside the local sign-in flow."
                                   TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="FindMyFlipper starts a local anisette service through Docker Desktop. Your Apple password and two-factor code are never saved."
                                   TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBox x:Name="AppleIdBox" Header="Apple ID" PlaceholderText="name@icloud.com" InputScope="EmailNameOrAddress" />
                                <PasswordBox x:Name="ApplePasswordBox" Header="Password" PasswordRevealMode="Peek" />
                                <ComboBox x:Name="SecondFactorBox" Header="Two-factor delivery" SelectedIndex="0" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Trusted Device" />
                                    <ComboBoxItem Content="SMS" />
                                </ComboBox>
                                <TextBox x:Name="TwoFactorBox" Header="Two-factor code" PlaceholderText="6-digit code" Visibility="Collapsed" />
                                <Button x:Name="ConnectAppleButton" Content="Connect with Apple" Click="ConnectApple_Click" Style="{StaticResource CriticalButtonStyle}" />
                            </StackPanel>
                        </Border>
                        <ProgressRing x:Name="AppleProgress" IsActive="False" Width="24" Height="24" />
                        <InfoBar x:Name="AppleInfo" IsOpen="True" IsClosable="False" Severity="Informational"
                                 Message="Checking the bundled backend and anisette service..." />
                    </StackPanel>
                </Grid>

                <Grid x:Name="BluetoothStep" Visibility="Collapsed">
                    <Grid RowSpacing="14">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Choose Your Flipper" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="Start the FindMyFlipper app on your Flipper, then select its saved Bluetooth name below. Pair it in Windows first if it appears under Paired devices. Anonymous Find My beacon advertisements cannot be connected."
                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <Grid Grid.Row="1" ColumnSpacing="12" MaxWidth="760" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="280" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BluetoothScanButton" Content="Start Bluetooth Scan" Click="ScanBluetooth_Click" Style="{StaticResource PrimaryButtonStyle}" />
                            <ProgressRing x:Name="BluetoothProgress" Grid.Column="1" Width="22" Height="22" IsActive="False" VerticalAlignment="Center" />
                            <TextBlock x:Name="BluetoothStatus" Grid.Column="2" Text="Ready to scan" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" Foreground="{StaticResource SecondaryTextBrush}" />
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="4,0,4,8" ColumnSpacing="20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Paired and named devices are pinned in discovery order so rows do not jump while you click." FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                                <ToggleSwitch x:Name="ShowUnnamedDevices" Grid.Column="1" Header="Show unnamed devices" HorizontalAlignment="Right" Toggled="ShowUnnamedDevices_Toggled" />
                            </Grid>
                            <ListView x:Name="BluetoothList" Grid.Row="1" SelectionMode="Single" SelectionChanged="BluetoothList_SelectionChanged" />
                        </Grid>
                    </Grid>
                </Grid>

                <Grid x:Name="TestStep" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="620" Spacing="16">
                        <TextBlock Text="Test Setup" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel x:Name="DiagnosticList" Spacing="13" />
                        </Border>
                        <InfoBar x:Name="DiagnosticInfo" IsOpen="False" IsClosable="False" />
                    </StackPanel>
                </Grid>
            </Grid>
            </Grid>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="32,10">
                <Button x:Name="BackButton" Content="Back" Click="Back_Click" Visibility="Collapsed" HorizontalAlignment="Left" />
                <Button x:Name="ContinueButton" Content="Continue" Click="Continue_Click" Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Center" MinWidth="180" />
            </Grid>
        </Grid>

        <!-- Main application shell. -->
        <Grid x:Name="AppShell" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
                <Grid Padding="18,22,18,18">
                    <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="56"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/icon.png" Width="38" Height="38" Stretch="Uniform" />
                        <TextBlock Text="FindMyFlipper" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" MaxLines="1" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="5">
                        <Button Style="{StaticResource NavButtonStyle}" Tag="map" Click="Navigate_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE707;"/><TextBlock Text="Map"/></StackPanel></Button>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="dashboard" Click="Navigate_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE80F;"/><TextBlock Text="Dashboard"/></StackPanel></Button>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="reports" Click="Navigate_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8A5;"/><TextBlock Text="Reports"/></StackPanel></Button>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="flipper" Click="Navigate_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE950;"/><TextBlock Text="Flipper"/></StackPanel></Button>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="profiles" Click="Navigate_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE716;"/><TextBlock Text="Profiles"/></StackPanel></Button>
                    </StackPanel>
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14" Margin="0,8">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse x:Name="SidebarStatusDot" Width="9" Height="9" Fill="#9CA3AF"/><TextBlock x:Name="SidebarConnection" Text="Flipper Disconnected" FontWeight="SemiBold"/></StackPanel>
                            <Grid><TextBlock Text="Battery" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock x:Name="SidebarBattery" Text="--" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid>
                        </StackPanel>
                    </Border>
                    <Button Grid.Row="3" Style="{StaticResource NavButtonStyle}" Tag="settings" Click="Navigate_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;"/><TextBlock Text="Settings"/></StackPanel></Button>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid x:Name="MapPage">
                    <WebView2 x:Name="MapWebView" NavigationCompleted="Map_NavigationCompleted" />
                    <Grid x:Name="NoReportsPanel" Background="{StaticResource BackgroundBrush}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="700" Spacing="20">
                            <StackPanel Orientation="Horizontal" Spacing="22" HorizontalAlignment="Center">
                                <Border Width="88" Height="88" CornerRadius="8" Background="{StaticResource SurfaceBrush}"><FontIcon Glyph="&#xE702;" FontSize="44" Foreground="{StaticResource AccentBrush}"/></Border>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="No Find My Reports Yet" FontSize="28" FontWeight="Bold"/><TextBlock Text="Your setup is ready to receive encrypted reports when nearby Apple devices detect your Flipper." Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel>
                            </StackPanel>
                            <Rectangle Height="1" Fill="{StaticResource CardBorderBrush}" />
                            <Grid ColumnSpacing="42"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="13"><TextBlock Text="Before refreshing" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="&#x2713;  Run FindMyFlipper on the Flipper."/><TextBlock Text="&#x2713;  Confirm the active .keys identity is on microSD."/><TextBlock Text="&#x2713;  Use a 1 second beacon interval and higher transmit power."/></StackPanel>
                                <StackPanel Grid.Column="1" Spacing="13"><TextBlock Text="Report access" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="NoReportsKeyStatus" Text="Private key   In Credential Manager"/><TextBlock x:Name="NoReportsBluetoothStatus" Text="Bluetooth    Disconnected"/><TextBlock x:Name="NoReportsBackendStatus" Text="Local backend   Checking"/><Button Content="Refresh Reports" Click="RefreshReports_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"/></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="MapTopBar" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="22" Padding="16,10"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE950;" Foreground="{StaticResource AccentBrush}"/><TextBlock x:Name="MapProfileName" Text="My Flipper" FontWeight="SemiBold"/><Ellipse Width="9" Height="9" Fill="#22C55E"/><TextBlock x:Name="MapConnectionText" Text="Connected"/></StackPanel></Border>
                        <Button Content="Play Alert" Click="PlayAlert_Click" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="DashboardPage" Visibility="Collapsed">
                    <StackPanel Margin="28" Spacing="20" HorizontalAlignment="Stretch">
                        <StackPanel><TextBlock x:Name="DashboardTitle" Text="My Flipper" FontSize="28" FontWeight="Bold"/><TextBlock Text="Dashboard" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel>
                        <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}" MinHeight="130"><StackPanel Spacing="8"><FontIcon Glyph="&#xE707;" Foreground="{StaticResource AccentBrush}"/><TextBlock x:Name="LastSeenValue" Text="Never" FontSize="24" FontWeight="Bold"/><TextBlock Text="Last Seen" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" MinHeight="130"><StackPanel Spacing="8"><FontIcon Glyph="&#xEBA0;" Foreground="#22C55E"/><TextBlock x:Name="BatteryValue" Text="--" FontSize="24" FontWeight="Bold"/><TextBlock Text="Battery" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" MinHeight="130"><StackPanel Spacing="8"><FontIcon Glyph="&#xE702;" Foreground="#22C55E"/><TextBlock x:Name="BluetoothValue" Text="Disconnected" FontSize="22" FontWeight="Bold" MaxLines="1"/><TextBlock Text="Bluetooth" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel></Border>
                            <Border Grid.Column="3" Style="{StaticResource CardStyle}" MinHeight="130"><StackPanel Spacing="8"><FontIcon Glyph="&#xE8A5;" Foreground="{StaticResource AccentBrush}"/><TextBlock x:Name="ReportsValue" Text="0" FontSize="24" FontWeight="Bold"/><TextBlock Text="Reports" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel></Border>
                        </Grid>
                        <Border Style="{StaticResource CardStyle}" Height="310"><Grid><TextBlock Text="Last Known Location" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Top"/><WebView2 x:Name="DashboardMap" Margin="0,44,0,0" NavigationCompleted="Map_NavigationCompleted" /></Grid></Border>
                        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><TextBlock Text="Quick Actions" FontSize="19" FontWeight="SemiBold"/><Grid ColumnSpacing="12" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="70"/></Grid.RowDefinitions><Button Click="PlayAlert_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="64" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE7ED;" Foreground="{StaticResource WarningBrush}"/><TextBlock Text="Play Alert" FontWeight="SemiBold"/></StackPanel></Button><Button Grid.Column="1" Click="OpenBluetooth_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="64" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE950;" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Scan for Flipper" FontWeight="SemiBold"/></StackPanel></Button><Button Grid.Row="1" Click="RunDiagnostics_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="64" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xEA18;" Foreground="{StaticResource SuccessBrush}"/><TextBlock Text="Test Setup" FontWeight="SemiBold"/></StackPanel></Button><Button Grid.Row="1" Grid.Column="1" Click="RefreshReports_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="64" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE72C;" Foreground="#168DE2"/><TextBlock Text="Refresh Reports" FontWeight="SemiBold"/></StackPanel></Button></Grid></StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="ReportsPage" Visibility="Collapsed" Margin="32">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><TextBlock Text="Reports" FontSize="28" FontWeight="Bold"/><ComboBox x:Name="ReportFilter" HorizontalAlignment="Right" SelectionChanged="ReportFilter_SelectionChanged"><ComboBoxItem Content="Today"/><ComboBoxItem Content="24 hours"/><ComboBoxItem Content="7 days"/><ComboBoxItem Content="All"/></ComboBox></Grid>
                    <ListView x:Name="ReportsList" Grid.Row="1" Margin="0,20,0,0" SelectionChanged="ReportsList_SelectionChanged" />
                    <TextBlock x:Name="ReportsFooter" Grid.Row="2" Text="0 reports total" HorizontalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,12" />
                </Grid>

                <ScrollViewer x:Name="FlipperPage" Visibility="Collapsed">
                    <StackPanel Margin="28" Spacing="18" HorizontalAlignment="Stretch">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="ms-appx:///Assets/flipper-zero.png" Width="220" Height="130" Stretch="Uniform"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8"><TextBlock x:Name="FlipperTitle" Text="My Flipper" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="FlipperConnection" Text="Disconnected" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock x:Name="FlipperDeviceId" Text="Windows BLE identifier: Not selected" FontFamily="Consolas" TextWrapping="Wrap"/><TextBlock x:Name="FlipperGeneratedMac" Text="Generated Find My MAC: Not imported" FontFamily="Consolas"/></StackPanel></Grid>
                        <Border Style="{StaticResource CardStyle}"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Connection" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock x:Name="DetailConnection" Text="Disconnected" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Signal" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock x:Name="DetailSignal" Text="--" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Battery" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock x:Name="DetailBattery" Text="--" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="Last connected" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock x:Name="DetailLastConnected" Text="Never" FontWeight="SemiBold"/></StackPanel></Grid></Border>
                        <Border Style="{StaticResource CardStyle}"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Play Alert" Click="PlayAlert_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch"/><Button Grid.Column="1" Content="Scan Again" Click="OpenBluetooth_Click" HorizontalAlignment="Stretch"/><Button Grid.Column="2" Content="Disconnect" Click="Disconnect_Click" HorizontalAlignment="Stretch"/></Grid></Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="ProfilesPage" Visibility="Collapsed" Margin="32">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid><TextBlock Text="Profiles" FontSize="28" FontWeight="Bold"/><Button Content="Add Profile" HorizontalAlignment="Right" Click="AddProfile_Click" Style="{StaticResource PrimaryButtonStyle}"/></Grid>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,20,0,0" VerticalAlignment="Top">
                        <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image Source="ms-appx:///Assets/flipper-zero.png" Width="74" Height="52" Stretch="Uniform"/><StackPanel Grid.Column="1" Spacing="6"><TextBlock x:Name="ProfileCardName" Text="My Flipper" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ProfileCardReports" Text="No reports yet" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock x:Name="ProfileCardMac" Text="Find My MAC: --" FontFamily="Consolas"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top"><Border Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="12" Padding="10,5" VerticalAlignment="Center"><TextBlock Text="Active" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/></Border><Button Content="&#x2026;" Click="RenameProfile_Click" Width="38" Height="36" FontSize="18" ToolTipService.ToolTip="Profile actions"/></StackPanel></Grid>
                    </Border>
                </Grid>

                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed">
                    <StackPanel Margin="28" Spacing="22" HorizontalAlignment="Stretch">
                        <TextBlock Text="Settings" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="General" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="16"><Grid><TextBlock Text="Refresh interval"/><ComboBox HorizontalAlignment="Right" SelectedIndex="2"><ComboBoxItem Content="Manual only"/><ComboBoxItem Content="5 minutes"/><ComboBoxItem Content="15 minutes"/><ComboBoxItem Content="30 minutes"/></ComboBox></Grid><ToggleSwitch Header="Launch at login"/><ToggleSwitch Header="Minimize to notification area"/></StackPanel></Border>
                        <TextBlock Text="Appearance" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="16"><Grid><TextBlock Text="Theme"/><ComboBox x:Name="ThemePicker" HorizontalAlignment="Right" SelectionChanged="ThemePicker_SelectionChanged"><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/><ComboBoxItem Content="System"/><ComboBoxItem Content="Sunset"/><ComboBoxItem Content="Ocean"/><ComboBoxItem Content="Forest"/><ComboBoxItem Content="Purple"/></ComboBox></Grid><Rectangle Height="1" Fill="{StaticResource CardBorderBrush}"/><Grid><TextBlock Text="Accent color"/><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"><Ellipse Width="16" Height="16" Fill="{StaticResource AccentBrush}"/><TextBlock x:Name="AccentName" Text="Orange"/></StackPanel></Grid></StackPanel></Border>
                        <TextBlock Text="Apple Access" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                        <Border Style="{StaticResource CardStyle}"><Grid><TextBlock x:Name="SettingsAppleStatus" Text="Find My reports: Checking"/><Button Content="Sign In Again" HorizontalAlignment="Right" Click="SignInAgain_Click"/></Grid></Border>
                        <TextBlock Text="Backend and Data" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><TextBlock x:Name="SettingsBackendStatus" Text="Local backend: Checking"/><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Restart Backend" Click="RestartBackend_Click" Style="{StaticResource CriticalButtonStyle}"/><Button Content="Refresh Reports" Click="RefreshReports_Click"/><Button Content="Reset App Data" Click="ResetData_Click" Style="{StaticResource CriticalButtonStyle}"/></StackPanel></StackPanel></Border>
                        <HyperlinkButton Content="Made by Arxhsz on GitHub" NavigateUri="https://github.com/Arxhsz" HorizontalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <InfoBar x:Name="GlobalWarning" IsOpen="False" IsClosable="True" Severity="Warning" VerticalAlignment="Top" Margin="232,12,12,0" />
    </Grid>
</Window>
