#include "../../../packaging/version.h"
#include <windows.h>

#define IDI_FINDMYFLIPPER 101
IDI_FINDMYFLIPPER ICON "Assets\\FindMyFlipper.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FINDMYFLIPPER_VERSION_MAJOR,FINDMYFLIPPER_VERSION_MINOR,FINDMYFLIPPER_VERSION_PATCH,FINDMYFLIPPER_VERSION_BUILD
 PRODUCTVERSION FINDMYFLIPPER_VERSION_MAJOR,FINDMYFLIPPER_VERSION_MINOR,FINDMYFLIPPER_VERSION_PATCH,FINDMYFLIPPER_VERSION_BUILD
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", FINDMYFLIPPER_COMPANY_NAME
            VALUE "FileDescription", FINDMYFLIPPER_FILE_DESCRIPTION
            VALUE "FileVersion", "1.0.0.1"
            VALUE "InternalName", "FindMyFlipper.exe"
            VALUE "OriginalFilename", "FindMyFlipper.exe"
            VALUE "ProductName", FINDMYFLIPPER_PRODUCT_NAME
            VALUE "ProductVersion", "1.0.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
